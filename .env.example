# ============================================================================
# Stock Reports Service — Environment Variables
# ============================================================================
# Copy to .env for local runs; set the same keys in the Railway dashboard.
# Every value below is a PLACEHOLDER — never commit real secrets.
# ============================================================================

# ── Clerk (authentication) ──────────────────────────────────────────────────
# Must be the SAME Clerk application as the trading_agents service, so both
# products see the same user IDs and therefore the same credit wallet.
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json

# ── Shared Postgres (credits) ───────────────────────────────────────────────
# On Railway, reference the Postgres service variable rather than pasting a
# literal URL:  DATABASE_URL=${{Postgres.DATABASE_URL}}
# Leave unset locally to fall back to SQLite.
DATABASE_URL=

# ── Cloudflare R2 (report storage) ──────────────────────────────────────────
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=stock-reports

# ── Admin endpoints ─────────────────────────────────────────────────────────
# Protects /api/admin/*. Generate a long random string.
ADMIN_SECRET_KEY=change-me

# ── Frontend / CORS ─────────────────────────────────────────────────────────
FRONTEND_URL=https://nexgen-solutions.org
# Optional comma-separated extras (preview deploys, apex vs www, etc.)
EXTRA_CORS_ORIGINS=

# ── Storage paths (defaults match the Railway volume) ───────────────────────
DATA_DIR=/data
STOCK_CSV_PATH=/data/stock_prices.csv

# ── Pricing ─────────────────────────────────────────────────────────────────
# Credits charged for one pack (all three reports).
PACK_CREDIT_COST=1

# ── Build schedule ──────────────────────────────────────────────────────────
# Hour (UTC) for the daily refresh + rebuild. 22 == ~6pm ET, after the close.
BUILD_HOUR_UTC=22
# How often the scheduler checks whether a build is due.
SCHEDULER_POLL_SECONDS=300
# Ceiling on a single build; the first cold-volume build downloads 20 years
# of history for ~300 tickers and can take several minutes.
BUILD_TIMEOUT_SECONDS=7200
# Build a pack at startup if none is ready. Set false for API-only local work.
BUILD_ON_BOOT=true

# ── Downloads ───────────────────────────────────────────────────────────────
# Lifetime of the presigned R2 links handed to the browser.
DOWNLOAD_URL_TTL_SECONDS=3600
